,{\"label\":\"Travel Feed: Variant C — Rating below title\",\"key\":\"travel_feed_variant_c\"},{\"key\":\"travel_feed_single\",\"label\":\"Travel Feed: Single hotel\"},{\"key\":\"travel_feed_ten_point\",\"label\":\"Travel Feed: Ten-point rating\"},{\"key\":\"travel_feed_sparse_metadata\",\"label\":\"Travel Feed: Sparse metadata\"},{\"label\":\"Pending: Image Card V2 — Single\",\"key\":\"pending_image_card_v2_single\"},{\"key\":\"pending_image_card_v2_single_collapse_on_image_completion\",\"label\":\"Pending: Image Card V2 — Single (collapse after image generation, iOS)\"},{\"key\":\"pending_product_card_v2_single\",\"label\":\"Pending: Product Card V2 — Single\"},{\"key\":\"pending_product_carousel\",\"label\":\"Pending: Compact Product Carousel — No price\"},{\"key\":\"pending_slideshow_landscape_auto_scroll\",\"label\":\"Pending: Slideshow 16:9 — 4 images (Auto-scroll)\"},{\"key\":\"conversation_bottom_slideshow_square_single\",\"label\":\"Conversation Bottom: Slideshow 1:1 — 1 image\"},{\"key\":\"previous_ad_native_image_preamble\",\"label\":\"ImageCardV2: Native — Preamble\"},{\"label\":\"ImageCardV2: Native — Keep visible on next send\",\"key\":\"previous_ad_native_image_keep_visible\"},{\"key\":\"geico_test_agent\",\"label\":\"GEICO Test Agent\"},{\"key\":\"image_card_v2_single_one_line\",\"label\":\"ImageCardV2: Single — One-line subtitle\"}]},\"is_device_based\":false,\"passed\":false},\"1122994996\":{\"name\":\"1122994996\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":14,\"id_type\":\"userID\",\"value\":{\"schemaVersion\":1,\"templates\":[{\"thumbnailUrl\":\"https://persistent.oaistatic.com/space-presentation-templates/product-strategy/c98a598ca5cbf03c29c276219182769ab676c32033bde9db71dd2c205624d721/cover.png\",\"revision\":\"c98a598ca5cbf03c29c276219182769ab676c32033bde9db71dd2c205624d721\",\"title\":\"Product Strategy\",\"id\":\"product-strategy\",\"source\":{\"url\":\"https://persistent.oaistatic.com/space-presentation-templates/product