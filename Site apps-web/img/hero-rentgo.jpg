cus-visible:ring-offset-0" role="button" tabindex="0" aria-label="Anexo do utilizador"><img class="h-full w-full rounded-md object-cover" referrerpolicy="no-referrer" alt="Anexo do utilizador" aria-expanded="false" data-state="closed" src="blob:https://chatgpt.com/33382782-a1cb-4fe9-8dc6-03dc94131ba7"></div></div><div class="w-full" data-content-search-unit-key="fallback-turn-0:0:user"><div class="group/user-message flex w-full flex-col gap-1 print:group-data-[print-formatting]/conversation-print:items-start items-end"><div data-user-message-bubble="true" class="bg-user-message text-user-message min-w-0 max-w-(--user-chat-width) overflow-hidden break-words px-(--thread-content-margin) [&amp;_.contain-inline-size]:[contain:initial] bubble-vBnidZ py-2.5 rounded-2xl relative text-start"><div class="flex flex-col items-end gap-1"><div class="relative w-full min-w-0 text-size-chat leading-relaxed"><div class="overflow-hidden" style="max-height: 19lh;"><div><div class="text-size-chat whitespace-pre-wrap" dir="auto">mete este filtro a funcionar e que no local de levantamento apareca as 3 opçoes de levantamento(Lisboa-Aeroporto,Porto-Aeroporto,Coimbra-estaçao), a data de levantamento so permite apartir do dia atual em que abrimos o site, dps de pesquisar tem que aparecer os carros disponiveis. Este é o codigo atual: &lt;!DOCTYPE html&gt;
&lt;html lang="pt"&gt;
&lt;head&gt;
    &lt;meta charset="UTF-8"&gt;
    &lt;meta name="viewport" content="width=device-width, initial-scale=1.0"&gt;
    &lt;title&gt;RentGo - Aluguer de Carros&lt;/title&gt;
    &lt;link rel="stylesheet" href="style.css"&gt;
&lt;/head&gt;
&lt;body&gt;

    &lt;header&gt;
        &lt;div class="nav-container"&gt;
            &lt;a href="index.html" class="logo"&gt;
                &lt;img src="img/logo-rentgo.png" alt="RentGo"&gt;
            &lt;/a&gt;
            &lt;button class="menu-toggle" aria-label="Abrir menu" aria-expanded="false"&gt;☰&lt;/button&gt;
            &lt;nav id="menu"&gt;
                &lt;a href="index.html" class="active"&gt;Início&lt;/a&gt;
                &lt;a href="frota.html"&gt;Frota&lt;/a&gt;
                &lt;a href="locais.html"&gt;Locais&lt;/a&gt;
                &lt;a href="como-funciona.html"&gt;Como funciona&lt;/a&gt;
                &lt;a href="apoio.html"&gt;Apoio&lt;/a&gt;
            &lt;/nav&gt;
            &lt;a href="entrar.html" class="btn-entrar"&gt;Entrar&lt;/a&gt;
        &lt;/div&gt;
    &lt;/header&gt;

    &lt;main class="container"&gt;
        &lt;!-- Hero Section --&gt;
        &lt;section class="hero"&gt;
            &lt;div&gt;
                &lt;h1&gt;Aluga o teu carro.&lt;br&gt;Simples e transparente.&lt;/h1&gt;
                &lt;p&gt;Viaja ao teu ritmo com preços claros e uma frota pronta para partir. Sem taxas escondidas.&lt;/p&gt;
            &lt;/div&gt;

            &lt;!-- Caixa de Pesquisa rápida --&gt;
            &lt;div class="search-box"&gt;
                &lt;h3 style="margin-bottom: 15px; color: var(--primary);"&gt;Encontrar um carro&lt;/h3&gt;
                &lt;form action="frota.html"&gt;
                    &lt;div class="form-group"&gt;
                        &lt;label&gt;Local de levantamento&lt;/label&gt;
                        &lt;input type="text" placeholder="Ex: Aeroporto de Lisboa" required&gt;
                    &lt;/div&gt;
                    &lt;div class="form-group"&gt;
                        &lt;label&gt;Data de levantamento&lt;/label&gt;
                        &lt;input type="date" required&gt;
                    &lt;/div&gt;
                    &lt;div class="form-group"&gt;
                        &lt;label&gt;Data de devolução&lt;/label&gt;
                        &lt;input type="date" required&gt;
                    &lt;/div&gt;
                    &lt;button type="submit" class="btn-primary" style="width: 100%;"&gt;Pesquisar carros&lt;/button&gt;
                &lt;/form&gt;
            &lt;/div&gt;
        &lt;/section&gt;

        &lt;!-- Vantagens --&gt;
        &lt;section style="margin-top: 40px;"&gt;
            &lt;h2 style="font-size: 22px; color: var(--primary);"&gt;Tudo incluído, sem surpresas&lt;/h2&gt;
            &lt;div class="grid-3"&gt;
                &lt;div class="card-vantagem"&gt;
                    &lt;h3&gt;Preço transparente&lt;/h3&gt;
                    &lt;p&gt;O valor que vês é o valor final. Sem taxas adicionais ao balcão.&lt;/p&gt;
                &lt;/div&gt;
                &lt;div class="card-vantagem"&gt;
                    &lt;h3&gt;Seguro incluído&lt;/h3&gt;
                    &lt;p&gt;Seguro básico e proteção contra danos já incluídos em todas as reservas.&lt;/p&gt;
                &lt;/div&gt;
                &lt;div class="card-vantagem"&gt;
                    &lt;h3&gt;Quilómetros Ilimitados&lt;/h3&gt;
                    &lt;p&gt;Conduz o quanto precisares sem qualquer cobrança por quilómetro extra.&lt;/p&gt;
                &lt;/div&gt;
            &lt;/div&gt;
        &lt;/section&gt;

        &lt;!-- CTA Final --&gt;
        &lt;section class="cta-banner"&gt;
            &lt;h2&gt;Pronto para partir?&lt;/h2&gt;
            &lt;p&gt;Encontra o carro ideal para a tua próxima viagem.&lt;/p&gt;
            &lt;a href="frota.html" class="btn-primary"&gt;Ver todos os carros&lt;/a&gt;
        &lt;/section&gt;
    &lt;/main&gt;

    &lt;footer&gt;
        &lt;p&gt;© 2026 RentGo · Aplicações Web · CBS Coimbra&lt;/p&gt;
    &lt;/footer&gt;

    &lt;script src="js/script.js"&gt;&lt;/script&gt;

&lt;/body&gt;
