class="ms-1 me-1 inline-block size-3 rounded-[3px] border border-default align-[-0.08em] ProseMirror-widget" contenteditable="false" data-hex-color-swatch="#ffffff" style="background-color: rgb(255, 255, 255);"></span>;     border-radius: 16px;     padding: 40px 20px;     text-align: center;     margin: 50px auto 20px auto; }  .cta-banner h2 {     font-size: 24px;     margin-bottom: 10px; }  .cta-banner p {     color: <span class="inline-markdown">#cbd5e1</span><span aria-hidden="true" class="ms-1 me-1 inline-block size-3 rounded-[3px] border border-default align-[-0.08em] ProseMirror-widget" contenteditable="false" data-hex-color-swatch="#cbd5e1" style="background-color: rgb(203, 213, 225);"></span>;     margin-bottom: 20px;     font-size: 14px; }  footer {     text-align: center;     padding: 30px;     font-size: 12px;     color: var(--text-muted);     border-top: 1px solid var(--border-color);     margin-top: 50px; }  /</em> ==========================================================    RESPONSIVO (tem de ficar sempre no fim do ficheiro)    ========================================================== <em>/  /</em> Tablet e telemóvel <em>/ @media (max-width: 768px) {     .hero {         grid-template-columns: 1fr;         padding: 30px 0;         gap: 28px;     }      .grid-2 {         grid-template-columns: 1fr;         gap: 28px;     }      .detalhe-grid {         grid-template-columns: 1fr;         gap: 20px;     }      .menu-toggle { display: block; }     .logo { margin-right: auto; }      .nav-container {         flex-wrap: wrap;         gap: 10px;     }      nav {         display: none;         order: 3;         width: 100%;         flex-direction: column;     }      nav.open { display: flex; }      nav a {         margin: 0;         padding: 12px 0;         border-top: 1px solid var(--border-color);     } }  /</em> Telemóveis pequenos <em>/ @media (max-width: 480px) {     .container { padding: 30px 16px; }     .search-box { padding: 20px; }     .cta-banner { padding: 30px 16px; }     .detalhe-info { padding: 18px; }      .specs-lista { grid-template-columns: 1fr; }     .search-box .btn-primary { width: 100%; }      /</em> 16px evita o zoom automático do iPhone ao tocar num campo */     .form-group input,     .form-group select,     .form-group textarea {         font-size: 16px;     } }  </p></div></div></div></div></div><div data-composer-leading-controls="true" class="min-w-0 col-start-1 row-start-2"><div class="flex min-w-0 items-center gap-[5px]"><div class="flex min-w-0 items-center"><button type="button" class="no-drag cursor-interaction items-center select-none disabled:cursor-default aria-disabled:cursor-default focus:outline-hidden disabled:opacity-40 aria-disabled:opacity-40 focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-0 whitespace-nowrap flex border gap-1 rounded-full text-tertiary not-disabled:not-aria-disabled:hover:bg-secondary-ghost-hover data-[state=open]:bg-secondary-ghost-hover border-transparent h-token-button-composer px-(--padding-button-composer-inline,calc(var(--spacing)*2)) py-0 text-(length:--text-button-composer,var(--text-sm)) leading-(--line-height-button-composer,18px) aspect-square shrink-0 items-center justify-center !px-0" aria-label="Adicionar ficheiros e mais" aria-expanded="false" data-composer-navigation-target="add-context" data-state="closed"><span class="CompactSource-d7ZD01" aria-hidden="true"><svg aria-hidden="true" class="Icon-X4VkKC text-default" focusable="false" height="16" viewBox="0 0 16 16" width="16" xmlns="http://www.w3.org/2000/svg"><use href="/cdn/assets/icons-7facfe40590b2f9e.svg#codex-icon-plus-lg-regular-16" fill="currentColor"></use></svg></span><span class="LeadingSource-d79mNZ" aria-hidden="true"><svg aria-hidden="true" class="Icon-X4VkKC text-default" focusable="false" height="20" viewBox="0 0 20 20" width="20" xmlns="http://www.w3.org/2000/svg"><use href="/cdn/assets/icons-7facfe40590b2f9e.svg#codex-icon-plus-lg-regular-20" fill="curren